{
  "name": "kafakafaya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^7.6.6",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.0",
    "vite": "^5.2.11"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@supabase/supabase-js": "^2.107.0",
    "kaplay": "^3001.0.0-alpha.20",
    "playroomkit": "^0.0.96"
  },
  "build": {
    "appId": "com.kafakafaya.game",
    "productName": "KafaKafaya",
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": "zip"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
